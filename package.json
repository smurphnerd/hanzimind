{
  "name": "hanzimind",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "doppler run -- next dev",
    "build": "env NODE_ENV=production next build",
    "build:local": "doppler run -- pnpm build",
    "start": "doppler run -- next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:push": "doppler run -- drizzle-kit push",
    "db:seed": "doppler run -- tsx --env-file=.env src/server/database/seed/index.ts",
    "test": "doppler run -- vitest run",
    "test:ci": "vitest run",
    "test-e2e": "doppler run -- pnpm playwright test",
    "email": "email dev --dir src/email --port 3100",
    "dev-containers": "docker compose -f development/docker-compose.yaml up"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/client-ses": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@hookform/resolvers": "^5.1.1",
    "@huggingface/transformers": "^4.2.0",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/tanstack-query": "^1.15.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-email/components": "^0.3.2",
    "@tanstack/react-query": "^5.83.0",
    "awilix": "^12.1.1",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "deepl-node": "^1.28.0",
    "drizzle-orm": "^0.45.2",
    "google-tts-api": "^2.0.2",
    "lucide-react": "^0.525.0",
    "nanoid": "^5.1.16",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "pinyin-pro": "^3.27.0",
    "pinyin-tone": "^2.4.0",
    "radix-ui": "^1.4.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-force-graph-2d": "^1.29.1",
    "react-hook-form": "^7.60.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@next/env": "^15.4.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.15",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "client-only": "^0.0.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-email": "4.0.8",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.3.5",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
