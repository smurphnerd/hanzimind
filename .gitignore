# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test output — vitest.config.ts writes junit.xml here on every run
/test-results

# Agent-harness mirrors. The source of truth is AGENTS.md and .agents/, which are
# committed; agentlink (.agents/agentlink.json) links each harness's own path to
# them locally, and none of those paths — nor worktrees under them — belong in a
# commit.
/.claude/
/.omp/
/.opencode/
/.cursor/
/.codex/
/.gemini/
/CLAUDE.md
/GEMINI.md

# verification lanes — per-lane env, pid and logs written by lane-up.sh
/development/lanes

# Copyrighted book sources and derived verbatim extracts (do not commit)
books/

# agentlink:begin
.claude/skills/
.omp/skills/
.opencode/skills/
# agentlink:end
